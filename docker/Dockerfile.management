FROM rust:1.97.0-bookworm@sha256:8fa55b2f3ddf97471ab6a767bfa3f37e6bad0986ba823e75fea57e2a2a5c3073 AS nornctl-builder

WORKDIR /build
COPY rust/Cargo.toml rust/Cargo.lock ./
COPY rust/crates ./crates
RUN cargo build --locked --release --package ri-chain-adapter --bin ri-nornctl

FROM python:3.13.11-slim@sha256:2b9c9803c6a287cafa0a8c917211dddd23dcd2016f049690ee5219f5d3f1636e AS python-builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /build
COPY pyproject.toml README.md requirements-production.lock ./
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --require-hashes -r requirements-production.lock
COPY src ./src
RUN /opt/venv/bin/pip install --no-deps . \
    && /opt/venv/bin/pip uninstall --yes pip setuptools

FROM python:3.13.11-slim@sha256:2b9c9803c6a287cafa0a8c917211dddd23dcd2016f049690ee5219f5d3f1636e

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN groupadd --gid 10001 resolver \
    && useradd --uid 10001 --gid resolver --home-dir /nonexistent --no-create-home resolver
WORKDIR /work
COPY --from=python-builder /opt/venv /opt/venv
COPY --from=nornctl-builder /build/target/release/ri-nornctl /usr/local/bin/ri-nornctl
COPY --chown=resolver:resolver tools/manage_v2_registry.py /app/tools/manage_v2_registry.py
COPY --chown=resolver:resolver contracts/out/ResolverIdentityRegistryV1.sol/ResolverIdentityRegistryV1.json \
    /app/contracts/out/ResolverIdentityRegistryV1.sol/ResolverIdentityRegistryV1.json
USER resolver
ENTRYPOINT ["python", "/app/tools/manage_v2_registry.py"]
