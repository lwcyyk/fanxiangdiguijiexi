FROM rust:1.97.0-bookworm@sha256:8fa55b2f3ddf97471ab6a767bfa3f37e6bad0986ba823e75fea57e2a2a5c3073 AS builder

WORKDIR /build
COPY rust/Cargo.toml rust/Cargo.lock ./
COPY rust/crates ./crates
RUN cargo build --locked --release --workspace

FROM debian:bookworm-slim@sha256:60eac759739651111db372c07be67863818726f754804b8707c90979bda511df

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

RUN printf '%s\n' 'resolver-rust:x:10002:' >> /etc/group \
    && printf '%s\n' \
        'resolver-rust:x:10002:10002:Resolver Identity runtime:/nonexistent:/usr/sbin/nologin' \
        >> /etc/passwd \
    && install --directory --owner=10002 --group=10002 \
        /var/lib/resolver-identity \
        /run/resolver-identity \
        /run/resolver-identity/trace

COPY --from=builder /build/target/release/ri-agent /usr/local/bin/ri-agent
COPY --from=builder /build/target/release/ri-wrapper /usr/local/bin/ri-wrapper
COPY --from=builder /build/target/release/ri-trace-adapter /usr/local/bin/ri-trace-adapter
COPY --from=builder /build/target/release/ri-registry-sync /usr/local/bin/ri-registry-sync
COPY --from=builder /build/target/release/ri-knot-trace-producer /usr/local/bin/ri-knot-trace-producer

USER resolver-rust
WORKDIR /var/lib/resolver-identity
