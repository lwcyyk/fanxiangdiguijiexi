# Copy to .env.sepolia.local, set chmod 600, and keep the real file out of Git.
# Values are intentionally empty. Use two independent HTTPS RPC providers.
RI_TESTNET_RPC_URL=
RI_TESTNET_VERIFY_RPC_URL=

GOVERNANCE_ADDRESS=
ROOT_PUBLISHER_ADDRESS=
RESOLVER_PUBLISHER_ADDRESS=
ENDPOINT_MANAGER_ADDRESS=
REVOKER_ADDRESS=

DEPLOYER_KEYSTORE_FILE=
DEPLOYER_KEYSTORE_PASSWORD_FILE=
GOVERNANCE_KEYSTORE_FILE=
GOVERNANCE_KEYSTORE_PASSWORD_FILE=
ROOT_PUBLISHER_KEYSTORE_FILE=
ROOT_PUBLISHER_KEYSTORE_PASSWORD_FILE=
RESOLVER_PUBLISHER_KEYSTORE_FILE=
RESOLVER_PUBLISHER_KEYSTORE_PASSWORD_FILE=
ENDPOINT_MANAGER_KEYSTORE_FILE=
ENDPOINT_MANAGER_KEYSTORE_PASSWORD_FILE=
REVOKER_KEYSTORE_FILE=
REVOKER_KEYSTORE_PASSWORD_FILE=

ISSUER_PRIVATE_KEY_FILE=
ISSUER_PUBLIC_KEY_FILE=
ISSUER_ID=
ISSUER_KEY_ID=

# Optional. Source verification is skipped and recorded when unset.
EXPLORER_API_KEY=

# Required real deployment inputs.
RI_DEPLOYMENT_INPUT_FILE=deployments/sepolia/private/deployment-input.json
RI_UNSIGNED_IDENTITIES_SOURCE=deployments/sepolia/private/identities-v2.unsigned.json
RI_ROOT_VERSION=1
RI_PREVIOUS_PLAN_FILE=

# Runtime values for the target DNS link. Do not use documentation addresses.
RI_AGENT_SERVER_ID=
RI_AGENT_KEY_ID=
RI_TRACE_PRODUCER_UID=
RI_TRACE_PRODUCER_GID=
RI_TRACE_SOCKET_HOST_DIR=
RI_WRAPPER_UPSTREAMS=
DNS_BIND_ADDRESS=
DNS_PORT=53

# Local preproduction controls.
RI_IMAGE=resolver-identity-rust:sepolia-preprod
RI_REGISTRY_FALLBACK_CONFIRMATIONS=12
RI_REGISTRY_MAX_STALENESS_SECONDS=15
RI_ACCEPTANCE_DNS_NAME=
RI_ACCEPTANCE_DNS_TYPE=A
RI_REVOCATION_TEST_SERVER_ID=
