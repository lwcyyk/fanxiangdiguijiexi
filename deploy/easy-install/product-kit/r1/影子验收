#!/usr/bin/env python3
"""R1 影子验收：在切流前比较入口 Wrapper 与原解析路径。"""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import shutil
import subprocess
import sys


def query(server: str, name: str, query_type: str) -> list[str]:
    result = subprocess.run(
        ["dig", f"@{server}", name, query_type, "+short", "+time=3", "+tries=1"],
        check=True, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    return sorted(line.strip() for line in result.stdout.splitlines() if line.strip())


def main() -> int:
    parser = argparse.ArgumentParser(description="R1 影子验收（只查询，不切换 DNS 流量）")
    parser.add_argument("--shadow-server", required=True, help="R1 Wrapper 影子地址")
    parser.add_argument("--baseline-server", required=True, help="原 DNS 地址")
    parser.add_argument("--name", required=True, help="批准的测试 FQDN")
    parser.add_argument("--type", default="A", choices=("A", "AAAA", "CNAME", "TXT"))
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    try:
        if not shutil.which("dig"):
            raise RuntimeError("缺少 dig 命令")
        baseline = query(args.baseline_server, args.name, args.type)
        shadow = query(args.shadow_server, args.name, args.type)
        evidence = {"name": args.name, "type": args.type, "baseline_server": args.baseline_server,
                    "shadow_server": args.shadow_server, "baseline_answers": baseline,
                    "shadow_answers": shadow, "result": "passed" if shadow == baseline and shadow else "failed"}
        rendered = json.dumps(evidence, ensure_ascii=False, indent=2) + "\n"
        if args.output:
            args.output.parent.mkdir(parents=True, exist_ok=True)
            temporary = args.output.with_name(f".{args.output.name}.tmp")
            temporary.write_text(rendered, encoding="utf-8")
            temporary.replace(args.output)
        print(rendered, end="")
        if evidence["result"] != "passed":
            print("错误代码：SHADOW002\n原因：影子路径与原路径答案不一致或为空\n建议：禁止切流，检查 R1 Wrapper、上游链路和批准的测试域名。", file=sys.stderr)
            return 2
        return 0
    except (OSError, subprocess.SubprocessError, RuntimeError) as exc:
        print(f"错误代码：SHADOW001\n原因：R1 影子验收无法执行：{exc}\n建议：安装 dig、检查两个 DNS 地址可达后重试；禁止提前切流。", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
