{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resolver-identity.invalid/schemas/domain-center-support-bundle-manifest-v1.json",
  "title": "Domain center redacted support bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "host", "source_commit", "files", "real_server_deployed", "production_traffic_enabled"],
  "properties": {
    "schema_version": {"const": "domain-center-support-bundle-manifest-v1"},
    "generated_at": {"type": "string", "minLength": 1},
    "host": {"type": "string", "minLength": 1},
    "source_commit": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"type": "null"}]},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "real_server_deployed": {"const": false},
    "production_traffic_enabled": {"const": false}
  }
}
