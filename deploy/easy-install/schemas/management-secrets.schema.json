{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resolver-identity.invalid/schemas/domain-center-management-secrets-v1.json",
  "title": "Management secret contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["directory", "files", "cross_file_rules"],
  "properties": {
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute", "regular_real_directory", "owner", "mode"],
      "properties": {
        "absolute": {"const": true},
        "regular_real_directory": {"const": true},
        "owner": {"const": "root:root"},
        "mode": {"const": "0700"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "format", "algorithm", "encrypted", "owner", "mode", "regular_non_symlink", "public_key_derivation"],
            "properties": {
              "name": {"enum": ["identity-issuer-ed25519-private-key", "snapshot-issuer-ed25519-private-key"]},
              "format": {"const": "PKCS#8 PEM"},
              "algorithm": {"const": "Ed25519"},
              "encrypted": {"const": false},
              "owner": {"const": "root:root"},
              "mode": {"const": "0600"},
              "regular_non_symlink": {"const": true},
              "public_key_derivation": {"const": "cryptography Ed25519 public key, SHA-256 raw public bytes"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "format", "algorithm", "encrypted", "owner", "mode", "regular_non_symlink", "public_key_derivation"],
            "properties": {
              "name": {"const": "publication-ssh-identity"},
              "format": {"const": "OpenSSH private key"},
              "algorithm": {"const": "Ed25519"},
              "encrypted": {"const": false},
              "owner": {"const": "root:root"},
              "mode": {"const": "0600"},
              "regular_non_symlink": {"const": true},
              "public_key_derivation": {"const": "cryptography Ed25519 public key, SHA-256 raw public bytes"}
            }
          }
        ]
      }
    },
    "cross_file_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer_keys_distinct", "publication_key_not_reused"],
      "properties": {
        "issuer_keys_distinct": {"const": true},
        "publication_key_not_reused": {"const": true}
      }
    }
  }
}
