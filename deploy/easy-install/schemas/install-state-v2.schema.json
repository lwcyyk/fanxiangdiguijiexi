{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resolver-identity.invalid/schemas/domain-center-install-state-v2.json",
  "title": "Domain center easy-install state v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "host", "role", "version", "role_sha256", "config_sha256", "images_sha256", "source_commit", "manifest_sha256", "install_id", "phases", "status", "status_zh", "last_error"],
  "properties": {
    "schema": {"const": "domain-center-install-state-v2"},
    "host": {"type": "string", "minLength": 1},
    "role": {"enum": ["management", "norn-a", "norn-b", "r1", "r2", "r3"]},
    "version": {"type": "string", "minLength": 1},
    "role_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "images_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"const": "not-requested"}]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "install_id": {"type": "string", "format": "uuid"},
    "phases": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z0-9._-]+$"}, "additionalProperties": {"type": "object"}},
    "status": {"enum": ["running", "complete", "failed", "uninstalled"]},
    "status_zh": {"enum": ["执行中", "完成", "完成（未启动）", "失败", "已卸载"]},
    "last_error": {"type": ["object", "null"]},
    "data_dir": {"type": "string", "minLength": 1},
    "release": {"type": "string", "minLength": 1},
    "activated": {"type": "boolean"},
    "data_purged": {"type": "boolean"}
  }
}
