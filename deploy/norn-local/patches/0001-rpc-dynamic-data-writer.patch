--- a/utils/serializer_test.go
+++ b/utils/serializer_test.go
@@ -1,6 +1,7 @@
 package utils
 
 import (
+	"bytes"
 	"crypto/ecdsa"
 	"crypto/elliptic"
 	"crypto/rand"
@@ -75,3 +76,39 @@ func TestSerializeTransaction(t *testing.T) {
 		t.Fatal("Verify transaction failed.")
 	}
 }
+
+func TestSerializeLargeTransactionAndBlock(t *testing.T) {
+	prv, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal("Generate keypair failed.")
+	}
+
+	tx := buildTransaction(prv)
+	tx.Body.Data = bytes.Repeat([]byte("r"), 2048)
+
+	txByteData, err := SerializeTransaction(tx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	decodedTx, err := DeserializeTransaction(txByteData)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(decodedTx.Body.Data, tx.Body.Data) {
+		t.Fatal("large transaction data did not survive serialization")
+	}
+
+	block := &common.Block{Transactions: []common.Transaction{*tx}}
+	blockByteData, err := SerializeBlock(block)
+	if err != nil {
+		t.Fatal(err)
+	}
+	decodedBlock, err := DeserializeBlock(blockByteData)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(decodedBlock.Transactions) != 1 ||
+		!bytes.Equal(decodedBlock.Transactions[0].Body.Data, tx.Body.Data) {
+		t.Fatal("large transaction data did not survive block serialization")
+	}
+}
