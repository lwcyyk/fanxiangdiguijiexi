// Test authoritative DNS backend for the resolver-identity Tencent Cloud lab.
// The Authority Proxy owns the public endpoint; BIND is loopback-only.
options {
    directory "/var/cache/bind";

    listen-on port 5353 { 127.0.0.1; };
    listen-on-v6 { none; };

    recursion no;
    allow-query { 127.0.0.1; };
    allow-transfer { none; };
    allow-recursion { none; };

    minimal-responses yes;
    version none;
    hostname none;
    server-id none;
};
